# ── QueryBot environment variables ────────────────────────────────────────────
# These are NO LONGER REQUIRED once you have run the first-time setup in the
# admin UI at http://YOUR-VM-IP:8000/admin
#
# They are provided here ONLY for reference / initial migration.
# The bot reads all credentials from the encrypted SQLite store at runtime.

# ── Key file location (optional override) ─────────────────────────────────────
# Default: ~/.querybot_key  (generated automatically on first run)
# QUERYBOT_KEY_FILE=/custom/path/.querybot_key

# ── Database file location (optional override) ────────────────────────────────
# Default: ./data/querybot.db
# DB_PATH=/var/lib/querybot/querybot.db

# ── Query execution limits ───────────────────────────────────────────────────
# Statement timeout for one user query, in seconds (clamped 1..600). The
# application wait derives itself from this + 30 s, so the database always
# raises first and its own "Query timeout expired" diagnostic survives.
# Raise this on a warehouse where a single fact scan is slow: a 9M-row fact
# read at ~61k rows/sec needs ~151 s per pass.
QUERYBOT_QUERY_TIMEOUT_SECONDS=300

# How long a resolved business-date anchor ("the newest date present in this
# fact") stays cached, in seconds. Set high on a warehouse that loads once a
# day — it avoids re-paying a full fact scan per question. 0 disables caching.
QUERYBOT_DATE_ANCHOR_TTL_SECONDS=900

# How long to remember that an anchor probe FAILED, so a probe already known to
# time out is not retried on every question.
QUERYBOT_DATE_ANCHOR_FAILURE_TTL_SECONDS=300

# How old the PERSISTED anchor may get before it must be re-probed. This is the
# one setting that bounds how stale a relative-date answer ("revenue today",
# "this month") can be after the warehouse is reloaded, and it was previously
# undocumented while defaulting to a full day.
#
# CAREFUL — 0 MEANS THE OPPOSITE HERE. On the TTL above, 0 means "never cache".
# Here it means "keep a stored anchor forever". To force a re-read after a
# reload, use the admin refresh action rather than a 0 whose direction you have
# to remember; schema discovery now invalidates it automatically.
QUERYBOT_DATE_ANCHOR_MAX_AGE_SECONDS=3600

# ── Prompt cache (preload the knowledge base instead of retrieving it) ───────
# OFF by default. When on, every table a user may query is sent in full at the
# front of the SQL prompt, the semantic search and cross-encoder re-rank are
# skipped entirely (~12.9 s a question on a live account), and the block is
# marked as a cache breakpoint so the provider stops re-reading it.
#
# This changes which documents the model sees and the order it sees them in, on
# the one prompt that decides whether an answer is right. Qualify it against
# the golden questions before turning it on for a client:
#
#   QUERYBOT_PROMPT_CACHE=on python -m evals.run --client <id> --cases <file> \
#       --generate --execute
#
# Then confirm it is actually caching: the log line "Anthropic prompt cache"
# must report cache_read_input_tokens above zero on the second question of a
# session. A permanent zero means something in the prefix is still varying,
# which is a bug to find rather than a reason to turn this back off. Azure and
# OpenAI cache prefixes automatically and report no counters, so there the
# evidence is the latency drop.
QUERYBOT_PROMPT_CACHE=off
