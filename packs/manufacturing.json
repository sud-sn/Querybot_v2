  "date_role_patterns": [
    {
      "pattern": "(?:^|_)(?:PLN|PLND|PLANNED|SCHD|SCHED|SCHEDULED)_(?:STRT|START|ST)_(?:DT|DATE)(?:_|$)",
      "role": "planned_start_date"
    },
    {
      "pattern": "(?:^|_)(?:MO|WO|MFG_ORD|MFGORD|PRDORD)_(?:STRT|START)_(?:DT|DATE)(?:_|$)",
      "role": "planned_start_date"
    },
    {
      "pattern": "(?:^|_)(?:ACT|ACTL|ACTUAL)_(?:STRT|START|ST)_(?:DT|DATE)(?:_|$)",
      "role": "actual_start_date"
    },
    {
      "pattern": "(?:^|_)(?:STRT|START)ED_(?:DT|DATE)(?:_|$)",
      "role": "actual_start_date"
    },
    {
      "pattern": "(?:^|_)(?:PLN|PLND|PLANNED|SCHD|SCHED|SCHEDULED)_(?:FIN|FNSH|FINISH|END|CMPL|COMPL|COMPLETION)_(?:DT|DATE)(?:_|$)",
      "role": "planned_finish_date"
    },
    {
      "pattern": "(?:^|_)(?:MO|WO|MFG_ORD|MFGORD|PRDORD)_(?:FIN|FNSH|FINISH|END)_(?:DT|DATE)(?:_|$)",
      "role": "planned_finish_date"
    },
    {
      "pattern": "(?:^|_)(?:ACT|ACTL|ACTUAL)_(?:FIN|FNSH|FINISH|END|CMPL|COMPL|COMPLETION)_(?:DT|DATE)(?:_|$)",
      "role": "actual_finish_date"
    },
    {
      "pattern": "(?:^|_)(?:CMPL|COMPL|COMPLETED|COMPLETION|FNSHD|FINISHED)_(?:DT|DATE)(?:_|$)",
      "role": "actual_finish_date"
    },
    {
      "pattern": "(?:^|_)(?:RLS|RLSE|RELEASE|RELEASED)_(?:DT|DATE)(?:_|$)",
      "role": "release_date"
    },
    {
      "pattern": "(?:^|_)(?:MO|WO)_(?:RLS|RLSE|RELEASE)_(?:DT|DATE)(?:_|$)",
      "role": "release_date"
    },
    {
      "pattern": "(?:^|_)(?:RPT|RPTD|REPORT|REPORTED|REPORTING)_(?:DT|DATE)(?:_|$)",
      "role": "reported_date"
    },
    {
      "pattern": "(?:^|_)(?:PRDN|PRODN|PROD|PRODUCTION)_(?:DT|DATE)(?:_|$)",
      "role": "reported_date"
    }
  ]
