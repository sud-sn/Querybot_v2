{
  "pack_id": "healthcare",
  "erp_name": "Healthcare, Claims and Pharmacy",
  "pack_kind": "industry",
  "version": 1,
  "status": "complete",
  "description": "Clinical, claims and pharmacy vocabulary for providers, payers and PBMs. Teaches the warehouse's SPELLINGS (DOS, SVC, ADM, DSCH, RX, NDC, DRG, LOS, IP/OP) and the six business dates a revenue-cycle question turns on — service, dispense, admission, discharge, claim and prescription — none of which the builtin English vocabulary reads, because SERVICE_DATE is a field-service visit in distribution and DISCHARGE_DATE is effluent in utilities. Carries no table or column dictionary, so it never competes with the ERP pack your database's naming detects — select it alongside that pack. Never maps a patient attribute: date of birth, death and enrolment stay unclassified so a period filter cannot land on one.",
  "date_role_patterns": [
    {
      "pattern": "^(SERVICE|SVC|SRVC|DOS|SERVICE_FROM|SVC_FROM|FROM_SERVICE|BEGIN_SERVICE|ENCOUNTER|ENCTR|VISIT|TREATMENT|PROCEDURE|PROC|SURGERY)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "service_date"
    },
    {
      "pattern": "^(SERVICE|SVC|SRVC|ENCOUNTER|ENCTR|VISIT|PROCEDURE|PROC)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "service_date"
    },
    {
      "pattern": "^(DOS|SVC_DT|SVC_DATE)$",
      "role": "service_date"
    },
    {
      "pattern": "^DATE_OF_(SERVICE|SVC|ENCOUNTER|VISIT|TREATMENT|PROCEDURE)(_KEY|_ID|_SK|_FK)?$",
      "role": "service_date"
    },
    {
      "pattern": "^DATE_OF_(ADMISSION|ADMIT)(_KEY|_ID|_SK|_FK)?$",
      "role": "admission_date"
    },
    {
      "pattern": "^DATE_OF_(DISCHARGE|DISCH)(_KEY|_ID|_SK|_FK)?$",
      "role": "discharge_date"
    },
    {
      "pattern": "^(DISPENSE|DISPENSED|DISPENSING|FILL|FILLED|RX_FILL)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "dispense_date"
    },
    {
      "pattern": "^(DISPENSE|DISPENSED|FILL|FILLED|RX_FILL)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "dispense_date"
    },
    {
      "pattern": "^(ADMIT|ADMISSION|ADMITTED|ADM|IP_ADMIT|INPATIENT_ADMIT)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "admission_date"
    },
    {
      "pattern": "^(ADMIT|ADMISSION|ADM)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "admission_date"
    },
    {
      "pattern": "^(DISCHARGE|DISCHARGED|DSCH|DISCH)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "discharge_date"
    },
    {
      "pattern": "^(DISCHARGE|DSCH|DISCH)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "discharge_date"
    },
    {
      "pattern": "^(CLAIM|CLM|CLAIM_SUBMISSION|CLAIM_SUBMIT|SUBMISSION|CLAIM_RECEIVED|CLAIM_RECEIPT|CLAIM_ENTRY)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "claim_date"
    },
    {
      "pattern": "^(CLAIM|CLM)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "claim_date"
    },
    {
      "pattern": "^(PRESCRIPTION|PRESCRIBED|PRESCRIBE|WRITTEN|RX_WRITTEN|RX_ORDER|ORDER_WRITTEN)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "prescription_date"
    },
    {
      "pattern": "^(PRESCRIPTION|PRESCRIBED|WRITTEN|RX)_DT(_KEY|_ID|_SK|_FK)?$",
      "role": "prescription_date"
    },
    {
      "pattern": "^(PAID|ADJUDICATION|ADJUDICATED|REMIT|REMITTANCE|CHECK|EOB)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "payment_date"
    },
    {
      "pattern": "^(STATEMENT|BILL|BILLED|BILLING|INVOICE_SENT)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "invoice_date"
    },
    {
      "pattern": "^(POSTED|POSTING|GL_POST|ACCOUNTING_PERIOD)_DATE(_KEY|_ID|_SK|_FK)?$",
      "role": "accounting_date"
    }
  ],
