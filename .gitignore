.env
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime SQLite database — this is live server state, not source. Tracking
# it means every deploy's live data drifts from the last commit, so every
# `git pull` on a running server hits "cannot pull: you have unstaged
# changes" and (worse) a careless stash+pull silently restores an old
# snapshot over the live database. See data/querybot.db removal commit.
data/querybot.db

# Persisted runtime connection configuration may contain database credentials.
data/pg_url

# The Fernet key every stored credential and system secret is encrypted with.
# data/querybot.db and data/pg_url were both ignored and this was not, so a
# single `git add -A` would have published the key that decrypts them.
data/.querybot_key

# Generated per-client lookup indexes are rebuilt from the client knowledge base.
clients/*/value_index.sqlite
# A tenant's naming profile is written by its KB build; it is runtime state.
clients/*/naming_profile.json
