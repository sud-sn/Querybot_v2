# QueryBot application database. Percent-encode special characters in passwords.
DATABASE_URL=postgresql://querybot:CHANGE_ME@127.0.0.1:5432/querybot

# Qdrant REST endpoint. Keep it private to the VM unless using Qdrant Cloud.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QUERYBOT_RERANK=true

# Public HTTPS address used in registration links and callbacks.
PORTAL_BASE_URL=https://querybot.example.com

# Use three independently generated values in production.
SESSION_SECRET=CHANGE_ME
PORTAL_SESSION_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME
PII_PSEUDONYM_SECRET=CHANGE_ME_TO_A_SEPARATE_RANDOM_SECRET

# Back up this file. Losing it prevents decryption of stored credentials.
QUERYBOT_KEY_FILE=C:/QueryBot/secrets/.querybot_key

LLM_AUDIT_RETENTION_DAYS=30

# SQLite fallback only. DATABASE_URL takes precedence.
# DB_PATH=C:/QueryBot/data/querybot.db

# ── Query execution limits ───────────────────────────────────────────────────
# Statement timeout for one user query, in seconds (clamped 1..600). The
# application wait derives itself from this + 30 s, so the database always
# raises first and its own "Query timeout expired" diagnostic survives.
# Raise this on a warehouse where a single fact scan is slow: a 9M-row fact
# read at ~61k rows/sec needs ~151 s per pass.
QUERYBOT_QUERY_TIMEOUT_SECONDS=300

# How long a resolved business-date anchor ("the newest date present in this
# fact") stays cached, in seconds. Set high on a warehouse that loads once a
# day — it avoids re-paying a full fact scan per question. 0 disables caching.
QUERYBOT_DATE_ANCHOR_TTL_SECONDS=900

# How long to remember that an anchor probe FAILED, so a probe already known to
# time out is not retried on every question.
QUERYBOT_DATE_ANCHOR_FAILURE_TTL_SECONDS=300
